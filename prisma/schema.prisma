generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

//ДЕЛАТЬ ТОЛЬКО МИГРАЦИИ И ДАВАТЬ КОМАНДЫ ТОЛЬКО НА МИГРАЦИИ НИКАКИХ npx pirsma push
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  password               String
  balance                Int       @default(1000) // Приветственный бонус 1000 баллов
  // ВАЖНО: role и roles живут вместе и всегда синхронны.
  //   role  — «главная» роль, ВСЕГДА равна roles[0]. Её читает старый код и Electron-приложение.
  //           Никогда не удалять: приложение обновляется тяжело, ломать контракт нельзя.
  //   roles — источник правды для сайта. Несколько ролей = несколько разделов в CRM.
  // Менять роли только через UsersService.setRoles() — он пишет оба поля разом.
  role                   Role      @default(USER)
  roles                  Role[]    @default([])
  userType               UserType? // Кто вы: маркетолог, SEO, предприниматель, стартапер
  referralSource         String? // Откуда узнал
  referralCode           String?   @unique // Реферальный код пользователя
  referredBy             String? // ID пользователя, который пригласил
  marketingCode          String? // Код SMM-поста (utm_campaign) из трекинг-ссылки; ставится напрямую при регистрации (фоллбэк — по IP)
  promoCode              String? // Промокод, введённый при регистрации (для трекинга источников/партнёров)
  city                   String? // Город пользователя
  isActive               Boolean   @default(true)
  isSuspicious           Boolean   @default(false) // Флаг подозрительной активности
  emailVerified          Boolean   @default(false) // Подтверждение email
  emailVerificationToken String?   @unique // Токен для подтверждения email
  lastLoginIp            String? // Последний IP входа
  lastSeenAt             DateTime? // Обновляется ТОЛЬКО heartbeat'ом приложения (app-only), не при веб-логине. На этом строится инференс appStatus
  registrationIp         String? // IP регистрации
  failedLoginAttempts    Int       @default(0) // Неудачные попытки входа
  lastFailedLogin        DateTime? // Последняя неудачная попытка
  appVersion             String? // Версия приложения пользователя
  appStatus              AppStatus @default(NEVER)
  appLastLoginAt         DateTime? // Последний логин с приложения (не с веб)
  uninstallToken         String?   @unique // Стабильный токен для beacon-пинга от деинсталлятора Windows
  winbackEmailSentAt     DateTime? // win-back: письмо «вернись +500» отправлено (один раз за всё время)
  winbackBonusGrantedAt  DateTime? // win-back: бонус +500 за возвращение начислен (один раз за всё время)
  weeklyReportEnabled    Boolean   @default(true) // Получать еженедельный отчёт
  aiAnalysesCount        Int       @default(0) // Количество выполненных AI-анализов
  priorityBoost          Int       @default(1) // Множитель приоритета в очереди задач (1 = норма, выше = чаще)
  // Привязка Telegram-бота уведомлений (@skyseo_notification_bot)
  telegramChatId            String?   @unique // chat_id пользователя в боте уведомлений; null = не привязан
  telegramUsername          String? // @username на момент привязки (для отображения в админке)
  telegramLinkCode          String?   @unique // 6-значный код привязки (одноразовый)
  telegramLinkCodeExpiresAt DateTime? // Срок годности кода привязки
  telegramLinkedAt          DateTime? // Когда привязал бота
  telegramContact           String? // Telegram-контакт, указанный при регистрации (необязательное поле)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  websites            Website[]
  executions          Execution[]
  payments            Payment[]
  balanceHistory      BalanceHistory[]
  passwordResetTokens PasswordResetToken[]
  clientNotes         ClientNote[]         @relation("ClientNotes")
  captchaEvents       CaptchaEvent[]
  dailyRewards        DailyReward[]
  algorithmAssignment AlgorithmAssignment?

  @@index([registrationIp, createdAt])
  @@index([marketingCode])
  @@map("users")
}

model Website {
  id                String   @id @default(uuid())
  userId            String
  name              String
  url               String
  city              String?
  isActive          Boolean  @default(true)
  isApproved        Boolean  @default(false) // true после одобрения админом; пока false — не попадает в выдачу задач
  isRestricted      Boolean  @default(false) // true если отклонён — показывает баннер "вы ограничены" у юзера
  dailyVisitsTarget Int? // Опциональный явный потолок визитов на сайт в сутки. Null = сумма target'ов всех активных ключей.
  autoMaxVisits     Boolean  @default(false) // Крутить всегда по максимуму сети (ceil(среднее ПК/день / 14)), динамически растёт с сетью
  adPolicy          String   @default("EXCLUDE") // Что открывать в выдаче Яндекса: EXCLUDE — не заходить на промо (реклама), ONLY — только промо, ALL — и то и другое
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks      Task[]
  statistics Statistic[]

  @@index([userId])
  @@map("websites")
}

model Task {
  id               String     @id @default(uuid())
  websiteId        String
  type             TaskType
  keyword          String? // Для поиска
  targetUrl        String? // Точный URL страницы для поиска (если задан — матчим по нему, иначе по домену)
  externalUrl      String? // Для внешних ссылок
  geo              String     @default("Москва") // Город для выполнения
  status           TaskStatus @default(PENDING)
  pointsCost       Int        @default(10) // Стоимость задачи
  priority         Int        @default(0)
  maxYandexVisits  Int        @default(3) // Максимум посещений из Яндекса в сутки
  maxGoogleVisits  Int        @default(3) // Максимум посещений из Google в сутки
  useYandex        Boolean    @default(true) // Использовать Яндекс
  useGoogle        Boolean    @default(true) // Использовать Google
  pagesDepthFrom   Int        @default(3) // Минимальная глубина просмотра страниц
  pagesDepthTo     Int        @default(5) // Максимальная глубина просмотра страниц
  pageDurationFrom Int        @default(60) // Минимальная длительность просмотра страницы (сек)
  pageDurationTo   Int        @default(180) // Максимальная длительность просмотра страницы (сек)
  isActive         Boolean    @default(true)
  keywordStatus    KeywordRestrictionStatus @default(ACTIVE)
  notifiedBestPosition Int? // Лучшая позиция в Яндексе, о которой уже уведомляли (для писем о росте только на новый рекорд). Стартовое значение = первая замеренная позиция (baseline, без письма)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  assignedAt         DateTime?
  assignedExecutorId String?
  completedAt        DateTime?

  website         Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  executions      Execution[]
  positionHistory PositionHistory[]
  pins            PinnedTask[]

  @@index([status, priority])
  @@index([assignedExecutorId])
  @@index([websiteId, status, isActive, keywordStatus, createdAt])
  @@map("tasks")
}

// Принудительная очередь: админ вручную ставит задание в начало раздачи.
// position — порядок выдачи следующим ПК (меньше = раньше). force=true обходит кулдауны/лимиты.
// Пин «сгорает» после того, как один ПК успешно взял задание (consumedAt/By).
model PinnedTask {
  id                   String    @id @default(uuid())
  taskId               String
  position             Int       @default(1)
  force                Boolean   @default(false)
  // Мягкий таргет на конкретный ПК (executorId): пока targetUntilAt в будущем — пин уходит
  // в начало только этому ПК; после — становится общим (любой некст ПК может взять).
  targetExecutorId     String?
  targetUntilAt        DateTime?
  consumedByExecutorId String?
  consumedAt           DateTime?
  createdByEmail       String?
  createdAt            DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([consumedAt, position])
  @@map("pinned_tasks")
}

model Execution {
  id            String          @id @default(uuid())
  taskId        String
  executorId    String
  websiteId     String?
  status        ExecutionStatus @default(IN_PROGRESS)
  pointsEarned  Int             @default(0)
  pointsSpent   Int             @default(0)
  foundInTop    Boolean?
  position      Int?
  yandexFoundInTop Boolean?
  googleFoundInTop Boolean?
  yandexPosition   Int?
  googlePosition   Int?
  yandexCreditedAt DateTime?
  googleCreditedAt DateTime?
  failureReason    FailureReason?
  targetVisited     Boolean         @default(false)
  directNavigationUsed Boolean      @default(false)
  completionKind    ExecutionCompletionKind?
  pagesVisited  Int             @default(0)
  duration      Int             @default(0)
  ipAddress     String?
  userAgent     String?
  weekStart     DateTime?
  // Версия алгоритма, применённая при СОЗДАНИИ выполнения (не при завершении — иначе плохая
  // версия в отчётах выглядит чище хорошей). null = зашитый в сборку алгоритм.
  algorithmVersion Int?
  createdAt     DateTime        @default(now())
  completedAt   DateTime?

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  executor User @relation(fields: [executorId], references: [id], onDelete: Cascade)
  events   ExecutionEvent[]

  @@index([executorId, websiteId, weekStart])
  @@index([executorId, status, completedAt])
  @@index([websiteId, status, completedAt])
  @@index([taskId, executorId, status])
  @@index([websiteId, foundInTop, completedAt])
  @@index([algorithmVersion, createdAt])
  @@map("executions")
}

model ExecutionEvent {
  id          String   @id @default(uuid())
  executionId String?
  taskId      String?
  executorId  String?
  engine      String?
  type        String
  stage       String
  details     Json?
  createdAt   DateTime @default(now())

  execution Execution? @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
  @@index([taskId, createdAt])
  @@index([executorId, createdAt])
  @@map("execution_events")
}

model CaptchaEvent {
  id        String   @id @default(uuid())
  userId    String
  engine    String   // "yandex" | "google"
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("captcha_events")
}

model Statistic {
  id             String   @id @default(uuid())
  websiteId      String
  keyword        String
  position       Int? // null если ниже топ-50
  inTop1         Int      @default(0)
  inTop2_3       Int      @default(0)
  inTop5         Int      @default(0)
  inTop10        Int      @default(0)
  inTop50        Int      @default(0)
  belowTop50     Int      @default(0)
  totalVisits    Int      @default(0)
  yandexSearches Int      @default(0) // Количество поисков в Яндексе
  googleSearches Int      @default(0) // Количество поисков в Google
  yandexVisits   Int      @default(0) // Количество визитов из Яндекса
  googleVisits   Int      @default(0) // Количество визитов из Google
  date           DateTime @default(now())
  createdAt      DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, keyword, date])
  @@map("statistics")
}

model PositionHistory {
  id             String   @id @default(uuid())
  taskId         String
  yandexPosition Int? // Позиция в Яндексе (null если не найдено)
  googlePosition Int? // Позиция в Google (null если не найдено)
  date           DateTime @default(now())
  createdAt      DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, date])
  @@map("position_history")
}

// Ручная проверка позиций через XMLRiver (кнопка «Проверить позиции» у админа).
// Отдельный time-series от PositionHistory (которая пишется визитами приложения) —
// накладывается на те же графики третьей линией. Сохраняется КАЖДАЯ проверка.
model KeywordCheck {
  id            String   @id @default(uuid())
  websiteId     String
  taskId        String? // связь с ключом-задачей (если ключ совпал)
  keyword       String
  position      Int? // позиция в Яндексе по XMLRiver (null = вне глубины проверки)
  url           String? // страница, которая ранжируется
  volume        Int? // частотность Wordstat на момент проверки
  lr            Int // код региона Яндекса
  city          String
  createdByEmail String?
  checkedAt     DateTime @default(now())

  @@index([websiteId, checkedAt])
  @@index([taskId, checkedAt])
  @@map("keyword_checks")
}

// Отчёт по позициям в Яндексе (XMLRiver). Админ вставляет домен + ключи один раз,
// а дальше «перезапрашивает» — каждый прогон это снапшот позиций всех ключей.
// Сравнение прогонов даёт историю «было так → на второй раз так → на третий так».
model PositionReport {
  id             String              @id @default(uuid())
  domain         String
  title          String?
  city           String              @default("Москва")
  keywords       String[]
  createdByEmail String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  runs           PositionReportRun[]

  @@index([createdAt])
  @@map("position_reports")
}

// Один прогон отчёта: снапшот результатов по всем ключам на момент проверки.
// results — JSON-массив [{ keyword, position, url, volume, error }].
model PositionReportRun {
  id             String         @id @default(uuid())
  reportId       String
  report         PositionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  results        Json
  cost           Float?
  depth          Int?
  createdByEmail String?
  createdAt      DateTime       @default(now())

  @@index([reportId, createdAt])
  @@map("position_report_runs")
}

model BalanceHistory {
  id          String             @id @default(uuid())
  userId      String
  amount      Int // Положительное или отрицательное
  type        BalanceHistoryType
  description String
  taskId      String?
  createdAt   DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, userId])
  @@map("balance_history")
}

// Ежедневная награда за то, что приложение было в сети (heartbeat) в этот день.
// Идемпотентность и календарь строятся на @@unique([userId, date]) (date = полночь UTC).
model DailyReward {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime // полночь UTC того дня, за который начислено
  points    Int      @default(50)
  streak    Int      @default(1) // длина серии на этот день (пропуск дня → сбрасывается в 1)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_rewards")
}

model Payment {
  id              String        @id @default(uuid())
  userId          String
  amount          Decimal       @db.Decimal(10, 2)
  points          Int
  status          PaymentStatus @default(PENDING)
  provider        String        @default("yookassa")
  externalId      String?       @unique // ID платежа в YooKassa
  confirmationUrl String?
  offerSentAt     DateTime? // Когда отправили письмо/TG со скидкой на брошенный (PENDING) платёж
  discountToken   String?   @unique // Токен для ссылки «оплатить со скидкой 10%» (одноразовый)
  issuedBy        String? // email менеджера/админа, вручную проведшего платёж (provider=manual). null = обычная онлайн-оплата
  createdAt       DateTime      @default(now())
  paidAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

// Внутренние заметки менеджера по клиенту. Клиент их НЕ видит. На клиента их
// может быть сколько угодно.
model ClientNote {
  id          String   @id @default(uuid())
  clientId    String // пользователь-клиент, к которому относится заметка
  authorEmail String // email менеджера/админа, написавшего заметку
  text        String
  createdAt   DateTime @default(now())

  client User @relation("ClientNotes", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@map("client_notes")
}

model AppVersion {
  id           String   @id @default(uuid())
  version      String
  platform     Platform // darwin-arm64, darwin-x64, win32-x64, win32-ia32
  downloadUrl  String
  sha512       String // SHA512 хеш файла в base64
  fileSize     Int // Размер файла в байтах
  releaseNotes String[]
  mandatory    Boolean  @default(false) // Обязательное обновление - блокирует работу старых версий
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([version, platform])
  @@map("app_versions")
}

model PageEvent {
  id          String   @id @default(uuid())
  type        String   // "visit" | "download" | "register"
  page        String?  // "/" | "/promo" | etc.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  referrer    String?
  platform    String?  // "mac-arm64" | "mac-x64" | "windows"
  ip          String?
  ref         String?  // referralCode пригласившего (из ?ref= в реф-ссылке) — для IP-атрибуции
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([utmSource, createdAt])
  @@index([ip, createdAt])
  @@map("page_events")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

enum Role {
  USER
  ADMIN
  SMM
  MANAGER
}

enum UserType {
  MARKETER // Маркетолог
  SEO // SEO специалист
  ENTREPRENEUR // Предприниматель
  STARTUP // Стартапер
}

enum TaskType {
  SEARCH_KEYWORD // Поиск по ключевому слову
  EXTERNAL_LINK // Переход по внешней ссылке
  SEARCH_AND_VISIT // Поиск и посещение сайта
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ExecutionStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ExecutionCompletionKind {
  NORMAL
  DEGRADED
  SKIPPED
}

enum BalanceHistoryType {
  WELCOME_BONUS
  TASK_EARNED
  TASK_SPENT
  PAYMENT
  REFUND
  ADMIN_ADJUSTMENT
  REFERRAL_BONUS
  DAILY_REWARD
  WINBACK_BONUS
}

enum FailureReason {
  CAPTCHA
  SCRIPT_ERROR
  NOT_IN_SERP
  LOCK_TIMEOUT
}

enum KeywordRestrictionStatus {
  ACTIVE
  RESTRICTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
  FAILED
}

enum AppStatus {
  NEVER       // Никогда не запускал приложение
  ACTIVE      // Приложение установлено и активно
  UNINSTALLED // Приложение удалено
  REINSTALLED // Приложение переустановлено после удаления
}

model PromoCode {
  id           String   @id @default(uuid())
  code         String   @unique // uppercase, без пробелов
  bonusPoints  Int      @default(500) // сколько баллов накидывается при регистрации
  description  String? // источник трафика — для напоминания себе
  isActive     Boolean  @default(true)
  budgetAmount Decimal? @db.Decimal(10, 2) // общий бюджет кампании ИЛИ ₽ за инстал — в зависимости от budgetMode
  budgetMode   String   @default("total")  // "total" | "per_install"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("promo_codes")
}

// Простой key-value для рантайм-настроек, меняемых без пересборки приложения.
// Сейчас хранит SOCS/CONSENT-куки Google для обхода окна согласия (читает desktop-app).
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_config")
}

// Яндекс РСЯ / Direct — управление кампаниями
model YandexAdCampaign {
  id                 String   @id @default(uuid())
  name               String?
  geo                String?
  landingUrl         String?
  dailyBudget        Int      @default(0)
  adsHeadlines       String? // multiline
  adsDescriptions    String? // multiline
  avatarOk           Boolean  @default(false)
  keywordsResearchOk Boolean  @default(false)
  analyticsOk        Boolean  @default(false)
  triadLinkOk        Boolean  @default(false) // связь ключ-объявление-лендинг
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  keywords YandexAdKeyword[]

  @@map("yandex_ad_campaigns")
}

model YandexAdKeyword {
  id           String   @id @default(uuid())
  campaignId   String
  keyword      String
  frequency    Int      @default(0)
  estimatedCpc Int      @default(0) // прогноз стоимости клика в рублях
  competition  String? // "низкая" / "средняя" / "высокая"
  shouldLaunch Boolean  @default(false)
  createdAt    DateTime @default(now())

  campaign YandexAdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("yandex_ad_keywords")
}

// Telegram посевы — плоский список каналов без группировки
model TelegramAdChannel {
  id          String    @id @default(uuid())
  link        String
  name        String?
  postText    String?   // текст рекламного поста
  promoCode   String?   // промокод для отслеживания конверсий
  postedAt    DateTime? // дата выкладки поста
  isActive    Boolean   @default(false) // флаг «начали работать»
  adReturn    Int?      // рекламная отдача ₽
  subscribers Int?
  reach24     Int?      // охваты за 24ч
  err24       Int?      // ERR (сырое значение из скрапера)
  postCost    Int?      // стоимость поста ₽
  isAuthor    Boolean   @default(false)
  shouldBuy   Boolean   @default(false)
  about       String?   // описание канала (из TGStat)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("telegram_ad_channels")
}

// Ручной учёт воронки по каналам. Заполняется в админке.
// SMM-пост: одна запись = один пост в ТГ-канале с трекинг-ссылкой.
// Регистрации/оплаты атрибутируются к посту по code (== utm_campaign в ссылке).
model MarketingPost {
  id          String   @id @default(uuid())
  code        String   @unique // короткий код в utm_campaign ссылки
  title       String // название поста (для SMM)
  tgUrl       String? // ссылка на сам пост в ТГ (для справки)
  tgText      String? // текст поста (для справки)
  destination String   @default("/") // путь на сайте, куда ведёт ссылка
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("marketing_posts")
}

model FunnelEntry {
  id            String   @id @default(uuid())
  date          DateTime @db.Date
  channel       String // "Instagram реклама", "TG канал", "Habr"
  views         Int      @default(0)
  cost          Int      @default(0) // рублей потрачено
  registrations Int      @default(0)
  purchases     Int      @default(0)
  revenue       Int      @default(0) // рублей пришло
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([channel])
  @@index([date])
  @@map("funnel_entries")
}

enum Platform {
  DARWIN_ARM64 // darwin-arm64
  DARWIN_X64 // darwin-x64
  WIN32_X64 // win32-x64
  WIN32_IA32 // win32-ia32
}

// Аутрич-лиды из Яндекс-парсера
enum OutreachStatus {
  NEW        // новые
  CONTACTED  // написал
  REPLIED    // ответил
  DEMO       // демо
  INSTALLED  // установил
  PAID       // оплатил
  DRAFT      // нет ответа 7 дней
}

model OutreachLead {
  id             String         @id @default(uuid())
  domain         String
  contact        String?        // главный контакт (телефон / tg / email)
  channel        String?        // WhatsApp / Telegram / Email / —
  phone          String?
  whatsapp       String?
  telegram       String?
  email          String?
  keywords       String?        // список запросов и позиций
  message        String         @db.Text
  status         OutreachStatus @default(NEW)
  contactedAt    DateTime?      // когда отправили
  contactedVia   String?        // email / tg
  emailsSent     Int            @default(0)
  tgLinkClicked  Int            @default(0)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@map("outreach_leads")
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM (Telegram Mini App на crm.skyseo.site). Отдельный контур: свои роли,
// свой Telegram-бот (TELEGRAM_CRM_BOT_TOKEN), доступ по вайтлисту TG-ID из env.
// Все модели АДДИТИВНЫ — старые таблицы не трогаются.
// ─────────────────────────────────────────────────────────────────────────────

enum CrmRole {
  ADMIN    // видит всё: всех сотрудников, кто что делает, подозрительные действия
  EMPLOYEE // сотрудник: видит свои задачи/клиентов и общий пул
}

enum CrmClientStatus {
  LEAD        // лид
  NEGOTIATION // переговоры
  ACTIVE      // в работе
  PAUSED      // на паузе
  CHURNED     // ушёл
}

enum CrmTaskStatus {
  DRAFT       // черновик
  TODO        // к выполнению
  IN_PROGRESS // в работе
  DONE        // готово
}

// Участник CRM. Заводится автоматически при первом входе через Telegram Mini App,
// если его telegramId есть в вайтлисте env (CRM_ADMIN_TELEGRAM_IDS / CRM_MEMBER_TELEGRAM_IDS).
// Профиль сотрудника в CRM. С переходом на общий вход платформы (email+пароль)
// главная связь — userId → users.id; роль берётся из User.roles, а не из env.
// Telegram теперь необязателен: он нужен для уведомлений и быстрого входа с телефона.
model CrmUser {
  id         String    @id @default(uuid())
  userId     String?   @unique // аккаунт платформы (users.id) — основной способ входа
  email      String? // денормализовано для отображения в списке команды
  telegramId String?   @unique // Telegram user id (число как строка); null = не привязан
  firstName  String?
  lastName   String?
  username   String? // @username на момент входа
  photoUrl   String?
  role       CrmRole   @default(EMPLOYEE)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  assignedClients CrmClient[]   @relation("CrmClientAssignee")
  assignedTasks   CrmTask[]     @relation("CrmTaskAssignee")
  createdTasks    CrmTask[]     @relation("CrmTaskCreator")
  createdClients  CrmClient[]   @relation("CrmClientCreator")
  reminders       CrmReminder[] @relation("CrmReminderTarget")
  activities      CrmActivity[] @relation("CrmActivityActor")
  assignedLeads   CrmLead[]     @relation("CrmLeadAssignee")
  assignedDeals   CrmDeal[]     @relation("CrmDealAssignee")

  @@map("crm_users")
}

// Карточка клиента в CRM. Можно связать с аккаунтом платформы (userId → users.id),
// тогда подтягиваются его сайты/ключи/позиции/визиты.
model CrmClient {
  id         String          @id @default(uuid())
  title      String // название/имя клиента
  company    String?
  phone      String?
  email      String?
  telegram   String?
  website    String?
  status     CrmClientStatus @default(LEAD)
  notes      String? // краткое описание/контекст
  userId     String? // связь с аккаунтом платформы (users.id). Не FK: платформенный User живёт своей жизнью
  assigneeId String? // ответственный сотрудник CRM
  createdById String?
  funnelId   String? // воронка, в которой находится клиент
  stageId    String? // этап воронки (колонка канбана)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  assignee  CrmUser?        @relation("CrmClientAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy CrmUser?        @relation("CrmClientCreator", fields: [createdById], references: [id], onDelete: SetNull)
  funnel    CrmFunnel?      @relation("ClientFunnel", fields: [funnelId], references: [id], onDelete: SetNull)
  stage     CrmFunnelStage? @relation("ClientStage", fields: [stageId], references: [id], onDelete: SetNull)
  tasks     CrmTask[]
  deals     CrmDeal[]

  @@index([status])
  @@index([assigneeId])
  @@index([userId])
  @@index([stageId])
  @@map("crm_clients")
}

// Воронка (пайплайн). Произвольное число этапов, у каждого свой заголовок и цвет —
// отображается как канбан. Клиент движется по этапам.
model CrmFunnel {
  id          String   @id @default(uuid())
  name        String
  color       String? // акцент воронки (hex)
  position    Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages  CrmFunnelStage[]
  clients CrmClient[]      @relation("ClientFunnel")

  @@map("crm_funnels")
}

model CrmFunnelStage {
  id        String   @id @default(uuid())
  funnelId  String
  title     String
  color     String   @default("#a0b5ff")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  funnel  CrmFunnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  clients CrmClient[] @relation("ClientStage")
  deals   CrmDeal[]   @relation("DealStage")

  @@index([funnelId, position])
  @@map("crm_funnel_stages")
}

// Задача CRM. clientId = null → задача команды (не привязана к клиенту).
// position — порядок внутри колонки канбана (для drag-and-drop).
model CrmTask {
  id          String        @id @default(uuid())
  title       String
  description String?
  status      CrmTaskStatus @default(TODO)
  priority    Int           @default(0) // -1 низкий, 0 обычный, 1 высокий, 2 срочный
  dueAt       DateTime? // дедлайн
  position    Int           @default(0) // порядок в колонке (DnD)
  clientId    String?
  assigneeId  String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  completedAt DateTime?

  client    CrmClient?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignee  CrmUser?      @relation("CrmTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy CrmUser?      @relation("CrmTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reminders CrmReminder[]

  @@index([status, position])
  @@index([assigneeId])
  @@index([clientId])
  @@index([dueAt])
  @@map("crm_tasks")
}

// Напоминание по задаче. На одну задачу можно повесить сколько угодно напоминаний
// (за час, за 10 минут, за день…). Каждое = отдельная строка с абсолютным remindAt.
// Шедулер раз в минуту шлёт сработавшие в CRM-бот целевому сотруднику.
model CrmReminder {
  id          String    @id @default(uuid())
  taskId      String
  remindAt    DateTime // абсолютное время срабатывания
  offsetLabel String? // «за 1 час», «за 10 минут» — для UI
  targetId    String? // кому напомнить; null → назначенному на задачу
  sent        Boolean   @default(false)
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  task   CrmTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  target CrmUser? @relation("CrmReminderTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([sent, remindAt])
  @@index([taskId])
  @@map("crm_reminders")
}

// Журнал действий в CRM — для роли админа: кто что делал + флаг подозрительных действий.
model CrmActivity {
  id         String   @id @default(uuid())
  actorId    String?
  action     String // "client.create" | "task.move" | "reminder.create" | "login" …
  entityType String? // "client" | "task" | "reminder"
  entityId   String?
  summary    String? // человекочитаемое описание
  suspicious Boolean  @default(false)
  createdAt  DateTime @default(now())

  actor CrmUser? @relation("CrmActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@map("crm_activity")
}

// ─── Лиды, сделки и тарифы ───────────────────────────────────────────────────
// Лид — входящая заявка ДО того, как стала клиентом. Раньше заявки с сайта уходили
// только в личку владельцу и нигде не сохранялись — их нельзя было ни взять в работу,
// ни посчитать. Квалифицированный лид превращается в клиента + сделку.

enum CrmLeadStatus {
  NEW // не разобран
  IN_WORK // взят в работу
  QUALIFIED // стал клиентом (создана сделка)
  REJECTED // отказ
}

enum CrmLeadSource {
  SITE_FORM // форма на сайте
  TELEGRAM
  OUTREACH // холодная рассылка
  REFERRAL
  MANUAL // завели руками
}

enum CrmDealStatus {
  OPEN
  WON
  LOST
}

model CrmLead {
  id           String        @id @default(uuid())
  title        String // имя / название
  contact      String? // телефон, email или @telegram — одним полем
  source       CrmLeadSource @default(MANUAL)
  utm          Json? // метки, если пришёл с рекламы
  status       CrmLeadStatus @default(NEW)
  comment      String? // первое касание
  rejectReason String? // почему отвалился — для аналитики
  assigneeId   String?
  createdById  String?
  clientId     String? // заполняется при квалификации
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  assignee CrmUser? @relation("CrmLeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([assigneeId])
  @@map("crm_leads")
}

// Сделка — деньги в воронке. Раньше воронка была, а сумм в ней не было:
// нельзя было ответить «сколько висит в работе».
model CrmDeal {
  id              String        @id @default(uuid())
  clientId        String
  title           String
  amount          Int           @default(0) // ₽
  tariffId        String?
  funnelId        String?
  stageId         String?
  probability     Int           @default(50) // 0..100, для прогноза
  expectedCloseAt DateTime?
  status          CrmDealStatus @default(OPEN)
  lostReason      String?
  assigneeId      String?
  createdById     String?
  position        Int           @default(0) // порядок внутри колонки
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client   CrmClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignee CrmUser?        @relation("CrmDealAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  stage    CrmFunnelStage? @relation("DealStage", fields: [stageId], references: [id], onDelete: SetNull)
  tariff   Tariff?         @relation(fields: [tariffId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([stageId, position])
  @@index([status, createdAt])
  @@map("crm_deals")
}

// Справочник тарифов. Закрывает реальную дыру: сейчас прайс захардкожен в трёх местах,
// курс баллов расходится между вебом и приложением, а сервер его не проверяет.
model Tariff {
  id          String    @id @default(uuid())
  name        String // «Старт», «Продвижение», «Максимум»
  description String?
  points      Int       @default(0) // сколько баллов даёт
  price       Int       @default(0) // сколько стоит, ₽
  isActive    Boolean   @default(true)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deals CrmDeal[]

  @@map("tariffs")
}

// ─── Доставка алгоритма с сервера ───────────────────────────────────────────
// См. ALGO_DELIVERY_TZ.md и skyseo_app/src/main/algo/. Подписанный бандл хранится
// целиком (готовый к отдаче), сервер его не собирает и не подписывает — только раздаёт.

enum AlgoBundleStatus {
  DRAFT        // загружен, ещё не выкачен
  CANARY       // на канареечных ПК
  LIVE         // на всей сети
  ROLLED_BACK  // откачен
}

model AlgorithmBundle {
  version       Int              @id // монотонный номер из подписанного манифеста
  label         String           // «05.08 фикс пагинации Яндекса»
  notes         String?
  status        AlgoBundleStatus @default(DRAFT)
  floor         Int              // из манифеста — для отображения
  minAppVersion String
  bundle        Json             // готовый SignedBundle целиком (manifest+sig+payload)
  sha256        String
  size          Int
  createdByEmail String?
  rollbackReason String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, version])
  @@map("algorithm_bundles")
}

// Что реально применилось на каждом ПК — телеметрия из отчётов приложения.
model AlgorithmAssignment {
  userId        String   @id
  appliedVersion Int?    // версия, которую ПК применил (0/null = зашитый)
  pinnedVersion Int?     // канарейка / «проверить на своём ПК»: закреплённая версия
  appVersion    String?
  lastError     String?  // текст ошибки применения — самый быстрый сигнал «не доехало»
  reportedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([appliedVersion])
  @@map("algorithm_assignments")
}
