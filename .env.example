# ─── CRM (Telegram Mini App на crm.skyseo.site) ───
# Вкл/выкл весь контур CRM (бот + страница + API). "false" — полностью выключено.
CRM_ENABLED="true"
# Отдельный бот CRM: открывает Mini App и шлёт напоминания сотрудникам
TELEGRAM_CRM_BOT_TOKEN=""
# Вайтлист участников CRM по Telegram user id (через запятую). Роль = список, в котором id.
CRM_ADMIN_TELEGRAM_IDS=""    # админы CRM (видят всё: сотрудников, действия)
CRM_MEMBER_TELEGRAM_IDS=""   # сотрудники
# Dev-обход входа: при NODE_ENV!=production можно войти как этот TG id без Telegram (localhost). В проде игнорируется.
CRM_DEV_TELEGRAM_ID=""
# URL мини-аппа (для кнопки-меню бота)
CRM_WEBAPP_URL="https://crm.skyseo.site"

# Email - выберите один из вариантов:

# Вариант 1: SMTP (Beget или другой хостинг) - РЕКОМЕНДУЕТСЯ
SMTP_HOST="smtp.beget.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@skyseo.site"
SMTP_PASS="_______"
SMTP_FROM="SkySEO <info@skyseo.site>"

# Вариант 2: Resend (если не используете SMTP, закомментируйте SMTP_HOST выше)
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM="SkySEO <info@skyseo.site>"

